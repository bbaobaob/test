# ── Discord Bot (required) ───────────────────────────────
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_guild_id_here
CHANNEL_ID=your_channel_id_here

# ── Template ────────────────────────────────────────────
TEMPLATE_FILE=data/roles_template.json

# ── Termux low-RAM defaults ─────────────────────────────
LOW_RAM_MODE=1
ENABLE_MEMBER_INTENT=0
ENABLE_LIVE_MEMBER_CACHE=0
COOLDOWN_SECONDS=2.5
PUBLIC_COMMAND_COOLDOWN_SECONDS=3
MEMBER_CACHE_TTL=3600
PICKER_TIMEOUT=90
ROLE_LIST_MAX=20
STATS_PRUNE_AFTER=60
LOG_LEVEL=info
PANEL_CHECK_INTERVAL=3600000

# ── Discord log channel (optional — send bot activity logs to Discord) ──
# LOG_CHANNEL_ID=channel_id_for_logs
